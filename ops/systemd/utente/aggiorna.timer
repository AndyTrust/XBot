# Scritto da installa.sh di XBot (utente). Modello: ops/systemd/utente/aggiorna.timer
# Ogni giorno alle 04:00 (se il computer era spento, al primo avvio dopo).
[Unit]
Description=@NOME@ (XBot): aggiornamento giornaliero

[Timer]
OnCalendar=*-*-* 04:00:00
Persistent=true
Unit=@SIGLA@-aggiorna.service

[Install]
WantedBy=timers.target
