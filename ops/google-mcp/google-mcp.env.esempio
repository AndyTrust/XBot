# Copia in google-mcp.env (0600, mai nel repository) e riempi. Nessun valore qui.
#
# Il client OAuth «Applicazione web» dell'utente su console.cloud.google.com (LEGGIMI.md, passo 1).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# L'indirizzo pubblico del server Google, con il prefisso che Caddy toglie:
# https://<host di XBot>/google-mcp (senza barra finale).
WORKSPACE_EXTERNAL_URL=
# GOOGLE_OAUTH_REDIRECT_URI non si mette: il server lo fa da sé, <WORKSPACE_EXTERNAL_URL>/oauth2callback.
# Con un percorso dentro (…/google-mcp/oauth2callback) il prefisso si raddoppia (provato il 2026-10-25).
# Solo gli host ammessi (senza porta), contro il DNS rebinding: l'host di XBot.
WORKSPACE_MCP_ALLOWED_HOSTS=
# Solo XBot si registra presso il proxy: <host di XBot>/api/v1/oauth/ritorno.
WORKSPACE_MCP_ALLOWED_CLIENT_REDIRECT_URIS=
# Facoltativo: chiave per firmare i token del proxy (almeno 32 caratteri casuali); senza, si
# deriva dal segreto del client.
FASTMCP_SERVER_AUTH_GOOGLE_JWT_SIGNING_KEY=
